description": {"en-US": "VokabelStar bringt das motivierende Duolingo-Lernprinzip auf Android –\n100% barrierefrei, ohne Schreibzwang und vollständig lokal und offline nutzbar.\n\nFeatures:\n- Optimiert für Screenreader (TalkBack, NVDA/JAWS-kompatible Bedienmuster)\n- Duolingo-Gamification: Tages-Streaks, XP, Herzen und Level-System\n- Echte Sprachausgabe über Android Text-to-Speech\n- 6 verschiedene interaktive Übungsmodi ohne Tastatur-Tippen\n- Universal-Import für eigene Vokabeldateien (Word .docx, Excel .xlsx, CSV, TXT)\n- Hoher Kontrastmodus (Gelb auf Schwarz) für Sehbehinderte\n- 100% Offline & Privat – keine Tracker, kein Cloud-Zwang"}, "preferredSigner": "6e29988c99e42885df447466b3fc50ea921cfd2144a5d360e56a2fde86500e94"}, "versions": {"3550b7a416dc771d1be1f49f981436d07995ead47e8bb7d982afcd73ec020e33": {"added": 1794661245000, "file": {"name": "/Lauju1909_VokabelStar-Android_v1.3.6_app-release.apk", "sha256": "3550b7a416dc771d1be1f49f981436d07995ead47e8bb7d982afcd73ec020e33", "size": 5128066}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86_64"], "versionName": "1.3.6", "versionCode": 12, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["6e29988c99e42885df447466b3fc50ea921cfd2144a5d360e56a2fde86500e94"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.VIBRATE"}, {"name": "de.lauri.vokabelstar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "0455482d542daed4b5626dc1a7329595ba3d57470f9bea52df38dedbbc8df3e0": {"added": 1794661245000, "file": {"name": "/Lauju1909_VokabelStar-Android_v1.3.4_VokabelStar_v1.3.4.apk", "sha256": "0455482d542daed4b5626dc1a7329595ba3d57470f9bea52df38dedbbc8df3e0", "size": 3731091}, "manifest": {"versionName": "1.3.4", "versionCode": 10, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["6e29988c99e42885df447466b3fc50ea921cfd2144a5d360e56a2fde86500e94"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "