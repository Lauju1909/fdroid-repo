rät"}, "preferredSigner": "6e29988c99e42885df447466b3fc50ea921cfd2144a5d360e56a2fde86500e94"}, "versions": {"c7525da23b32edcac28bad8bc8f67897001df3d2b1f22113703b7e0eb776f629": {"added": 1794661241000, "file": {"name": "/Lauju1909_BarrierefreierDokumentenBetrachter-Android_v1.0.8_app-release.apk", "sha256": "c7525da23b32edcac28bad8bc8f67897001df3d2b1f22113703b7e0eb776f629", "size": 5447950}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86_64"], "versionName": "1.0.8", "versionCode": 9, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["6e29988c99e42885df447466b3fc50ea921cfd2144a5d360e56a2fde86500e94"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.VIBRATE"}, {"name": "de.lauri.dokumentenbetrachter.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "de.lauri.finanzapp": {"metadata": {"added": 1794661240000, "categories": ["Money"], "issueTracker": "https://github.com/Lauju1909/BarrierefreieFinanzApp-Android/issues", "lastUpdated": 1794661241000, "license": "MIT", "sourceCode": "https://github.com/Lauju1909/BarrierefreieFinanzApp-Android", "authorName": "Lauju1909", "name": {"en-US": "Haushaltsbuch Barrierefrei"}, "summary": {"en-US": "Barrierefreies Haushaltsbuch mit TalkBack-Unterstützung und sicherem Offline-Tresor"}, "description": {"en-US": "Haushaltsbuch Barrierefrei ist eine intuitive und sichere Finanz-App, entwickelt für\nMenschen mit Sehbehinderung, Blindheit und alle, die eine klare barrierefreie Finanzverwaltung schätzen.\n\nFeatures:\n- Optimiert für Screenreader (TalkBack, NVDA/JAWS-kompatible Bedienmuster)\n- Hoher Kontrast, anpassbare Schriftgrößen und OLED-Dark-Mode\n- Flexible Abrechnungszeiträume (monatlich, wöchentlich, flexibel)\n- Spartöpfe, Daueraufträge, Wunschlisten\n- Lokaler, verschlüsselter Offline-Tresor ohne Cloud-Zwang\n- Schutz per PIN und Biometrie (Fingerabdruck)\n- Beleg-, Quittungs- und Rechnungserfassung mit OCR\n- Interaktive Einkaufsliste mit What